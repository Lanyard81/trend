{
  "name": "trend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "main": "electron.cjs",
  "description": "Weight loss tracker",
  "author": "Training Table",
  "build": {
    "appId": "com.trend.app",
    "productName": "Trend",
    "files": [
      "dist/**",
      "electron.cjs",
      "public/icon-512.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trend",
      "artifactName": "Trend-Setup-${version}.${ext}",
      "uninstallDisplayName": "Trend"
    },
    "portable": {
      "artifactName": "Trend-Portable.${ext}"
    }
  }
}